{
  "name": "kusari-wallet",
  "version": "0.71.3",
  "description": "XMR, BTC, ETH, TRX, USDT wallet",
  "main": "dist/main/app.js",
  "scripts": {
    "build": "node scripts/gen-keys.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js && node scripts/bundle-main.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/unit.test.js tests/sol-pool.test.js tests/donate.test.js tests/attack-new-coins.test.js tests/tron.test.js tests/monero-busy.test.js tests/tor.test.js tests/swap.test.js tests/btc.test.js tests/btc-filters.test.js tests/ltc-filters.test.js tests/payjoin-crypto.test.js tests/payjoin.test.js tests/pegasus.test.js tests/btc-silent.test.js tests/seed.test.js tests/lookalike.test.js tests/socks-gate.test.js tests/eth.test.js tests/privacy.test.js tests/tornado.test.js tests/wallets.test.js tests/prices.test.js tests/buy.test.js tests/bch.test.js tests/ltc.test.js tests/tokens.test.js tests/dex.test.js tests/mweb.test.js tests/balances.test.js tests/balance-cache.test.js tests/bundle.test.js tests/dash.test.js tests/firo.test.js tests/locales.test.js tests/doge.test.js tests/sol.test.js tests/ton.test.js tests/zec.test.js tests/zano.test.js tests/ksr.test.js tests/kusari-zano.test.js tests/arrr.test.js tests/spark.test.js tests/dcr.test.js tests/dcr-mix.test.js tests/coinjoin.test.js tests/tcp-bridge.test.js tests/tor-bridges.test.js tests/wabisabi.test.js tests/btc-mix.test.js",
    "test:monero": "npm run build && node tests/monero-regtest.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:ui": "npm run build && xvfb-run -a node tests/ui-e2e.js",
    "dist:android": "bash scripts/build-android.sh",
    "check:package": "node scripts/check-package.js",
    "dist:win-dev": "node scripts/dist-dev.js"
  },
  "keywords": [],
  "author": "Edge",
  "license": "MIT",
  "dependencies": {
    "web-worker": "^1.3.0"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0",
    "@scure/btc-signer": "^2.4.1",
    "@ton/core": "^0.60.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.2.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "circomlib": "github:tornadocash/circomlib#3b492f9801573eebcfe1b6c584afe8a3beecf2b4",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ethers": "6.17.0",
    "events": "^3.3.0",
    "fixed-merkle-tree": "^0.6.1",
    "ganache": "^7.9.2",
    "jsqr": "^1.4.0",
    "monero-ts": "^0.11.21",
    "openpgp": "^6.3.2",
    "path-browserify": "^1.0.1",
    "playwright": "^1.64.1",
    "poseidon-lite": "^0.3.0",
    "pretendard": "^1.3.9",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "snarkjs": "github:tornadocash/snarkjs#869181cfaf7526fe8972073d31655493a04326d5",
    "snarkjs7": "npm:snarkjs@^0.7.6",
    "socks-proxy-agent": "^8.0.5",
    "solc": "^0.7.6",
    "stream-browserify": "^3.0.0",
    "tar": "^7.5.22",
    "tronweb": "^6.5.1",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "websnark": "github:tornadocash/websnark#4c0af6a8b65aabea3c09f377f63c44e7a58afa6d"
  },
  "productName": "Kusari Wallet",
  "private": true,
  "build": {
    "appId": "dev.edge.vaultwallet",
    "productName": "Kusari Wallet",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/main/app.js",
      "dist/main/app.js.LEGAL.txt",
      "dist/main/monero-worker.js",
      "dist/main/monero-worker.js.LEGAL.txt",
      "dist/main/tornado-worker.js",
      "dist/main/tornado/**",
      "dist/main/solpool-worker.js",
      "dist/main/solpool/**",
      "dist/preload/**",
      "dist/renderer/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/web-worker/**",
      "dist/main/monero-worker.js",
      "dist/main/tornado-worker.js",
      "dist/main/tornado/**",
      "dist/main/solpool-worker.js",
      "dist/main/solpool/**"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "native-bin/desktop",
          "to": "zec",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/zano",
          "to": "zano",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/ksr",
          "to": "ksr",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/arrr",
          "to": "arrr",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/mweb",
          "to": "mweb",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/spark",
          "to": "spark",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Finance",
      "extraResources": [
        {
          "from": "native-bin/params",
          "to": "zec",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/zec-linux",
          "to": "zec",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/zano-linux",
          "to": "zano",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/arrr-linux",
          "to": "arrr",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/mweb-linux",
          "to": "mweb",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/spark-linux",
          "to": "spark",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "build/linux/start-kusari-wallet.sh",
          "to": "start-kusari-wallet.sh"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.finance",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "native-bin/params",
          "to": "zec",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/zec-mac-${arch}",
          "to": "zec",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/zano-mac-${arch}",
          "to": "zano",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/arrr-mac-${arch}",
          "to": "arrr",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/mweb-mac-${arch}",
          "to": "mweb",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native-bin/spark-mac-${arch}",
          "to": "spark",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": false
    },
    "artifactName": "KusariWallet-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "afterSign": "scripts/mac-adhoc-sign.js"
  },
  "overrides": {
    "axios": "1.21.0"
  }
}
