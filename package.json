{
  "name": "kusari-wallet",
  "version": "0.27.0",
  "description": "XMR, BTC, ETH, TRX, USDT wallet",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/gen-keys.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/unit.test.js tests/tron.test.js tests/monero-busy.test.js tests/tor.test.js tests/swap.test.js tests/btc.test.js tests/eth.test.js tests/privacy.test.js tests/tornado.test.js tests/wallets.test.js tests/prices.test.js tests/balances.test.js tests/dash.test.js tests/firo.test.js tests/locales.test.js tests/doge.test.js tests/sol.test.js tests/zec.test.js tests/zano.test.js tests/arrr.test.js",
    "test:monero": "npm run build && node tests/monero-regtest.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:ui": "npm run build && xvfb-run -a node tests/ui-e2e.js",
    "dist:android": "bash scripts/build-android.sh"
  },
  "keywords": [],
  "author": "Edge",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0",
    "@scure/btc-signer": "^2.4.1",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "ethers": "6.17.0",
    "events": "^3.3.0",
    "jsqr": "^1.4.0",
    "monero-ts": "^0.11.21",
    "openpgp": "^6.3.2",
    "path-browserify": "^1.0.1",
    "pretendard": "^1.3.9",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^8.0.5",
    "tar": "^7.5.22",
    "tronweb": "^6.5.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "circomlib": "github:tornadocash/circomlib#3b492f9801573eebcfe1b6c584afe8a3beecf2b4",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fixed-merkle-tree": "^0.6.1",
    "ganache": "^7.9.2",
    "playwright": "^1.64.1",
    "snarkjs": "github:tornadocash/snarkjs#869181cfaf7526fe8972073d31655493a04326d5",
    "solc": "^0.7.6",
    "stream-browserify": "^3.0.0",
    "typescript": "^7.0.2",
    "websnark": "github:tornadocash/websnark#4c0af6a8b65aabea3c09f377f63c44e7a58afa6d"
  },
  "productName": "Kusari Wallet",
  "private": true,
  "build": {
    "appId": "dev.edge.vaultwallet",
    "productName": "Kusari Wallet",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**",
      "dist/main/tornado-worker.js",
      "dist/main/tornado/**"
    ],
    "extraResources": [
      {
        "from": "native-bin/desktop",
        "to": "zec",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native-bin/zano",
        "to": "zano",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native-bin/arrr",
        "to": "arrr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": false
    },
    "artifactName": "KusariWallet-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "overrides": {
    "axios": "1.21.0"
  }
}
